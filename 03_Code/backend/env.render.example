# Copier ces clés dans Render → Environment (Web Service)
# Remplacez VOTRE_URL par l'URL Render après le 1er déploiement

NODE_ENV=production
PORT=4000

DATABASE_POOLER_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require

JWT_SECRET=changez-moi-32-caracteres-minimum-aleatoires

CORS_ORIGIN=https://paysafe-xxxx.onrender.com
APP_BASE_URL=https://paysafe-xxxx.onrender.com

ADMIN_PHONES=+22893224301

FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=sk_sandbox_VOTRE_CLE
FEDAPAY_PUBLIC_KEY=pk_sandbox_VOTRE_CLE
FEDAPAY_WEBHOOK_SECRET=whsec_VOTRE_SECRET

# Phase 1 (sans FedaPay) : true — Phase 2 (FedaPay réel) : false
ALLOW_SIMULATE_PAYMENT=true
SMS_PROVIDER=console

# Phase 2 — ajouter quand vous avez les clés FedaPay :
# FEDAPAY_SECRET_KEY=sk_sandbox_...
# FEDAPAY_PUBLIC_KEY=pk_sandbox_...
# FEDAPAY_WEBHOOK_SECRET=whsec_...
