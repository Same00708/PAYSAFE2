NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Direct (souvent timeout / ENOTFOUND sur Windows sans IPv6)
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres?uselibpqcompat=true&sslmode=require

# OBLIGATOIRE pour PaySafe sur Windows : Session pooler IPv4
# Génération auto : npm run db:discover-pooler
# Ou Dashboard Supabase → Connect → Session pooler → copier l'URI :
DATABASE_POOLER_URL=postgresql://postgres.PROJECT:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require

# Numéros admin (secours, virgule si plusieurs)
ADMIN_PHONES=+22893224301

JWT_SECRET=minimum-32-caracteres-secret-jwt-paysafe
JWT_EXPIRES_IN=7d

# SMS — choisir twilio ou termii (recommandé Afrique de l'Ouest)
SMS_PROVIDER=termii
TERMII_API_KEY=
TERMII_SENDER_ID=PaySafe

# Alternative Twilio
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Dev local sans SMS (affiche le code à l'écran)
USE_FIXED_OTP=true
OTP_DEV_CODE=123456
EXPOSE_OTP_IN_RESPONSE=true
SMS_FALLBACK_CONSOLE=true

ALLOW_SIMULATE_PAYMENT=true

FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_PUBLIC_KEY=pk_sandbox_xxxxx
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxx
FEDAPAY_WEBHOOK_SECRET=whsec_xxxxx
FEDAPAY_CALLBACK_URL=http://localhost:5173/transactions
