{
  "name": "paysafe-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API PaySafe — escrow, chat, FedaPay",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:web": "npm install --prefix ../web && npm run build --prefix ../web",
    "build": "tsc",
    "build:all": "npm run build:web && tsc",
    "start": "node dist/index.js",
    "start:prod": "node dist/db/migrateBoot.js && node dist/index.js",
    "lint": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "tsx scripts/test-register.ts",
    "db:test-connection": "tsx scripts/db-connect-test.ts",
    "db:discover-pooler": "tsx scripts/discover-pooler.ts",
    "db:setup": "tsx src/db/migrate.ts && tsx src/db/seed.ts && tsx scripts/test-register.ts",
    "db:migrate-auth": "tsx src/db/migrateAuthOnly.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:users": "tsx src/db/seedUsers.ts",
    "check:integrations": "tsx scripts/test-integrations.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
